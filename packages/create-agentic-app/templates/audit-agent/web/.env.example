# Core API connection (server-only, never exposed to browser)
AGENTIC_CORE_BASE_URL=http://localhost:8000
AGENTIC_CORE_API_KEY=your-api-key-here

# Agent ID for chat (public, used by frontend)
NEXT_PUBLIC_AGENT_ID=

# Audit LLM extraction (server-only)
AUDIT_LLM_API_KEY=
AUDIT_LLM_MODEL=gpt-4o

# SQLite database path
AUDIT_AGENT_DB_PATH=./audit-agent.db
